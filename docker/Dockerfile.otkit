# pyscan-otkit — the all-in-one image for a blue-team OT exercise.
# Ships pyscan with every extra, plus tshark and nmap for cross-checking.
# Build from the REPOSITORY ROOT:
#     docker build -f docker/Dockerfile.otkit -t pyscan-otkit .
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

# tshark for its OT dissectors, nmap for a second opinion on inventory,
# libpcap for scapy's raw SYN scan, iproute2 for ip/ss.
RUN apt-get update && apt-get install -y --no-install-recommends \
        tshark nmap libpcap0.8 iproute2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# syn -> scapy (raw SYN scan) - tui -> textual (both TUIs) - lab -> pymodbus (the RTU simulator)
# LICENSE is not optional here: pyproject declares it, so the build
# backend reads it while generating metadata.
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-cache-dir ".[syn,tui,lab]"

COPY tools ./tools

# The exercise workspace: captures and exported incident reports land here, and
# docker-compose mounts it from the host so both outlive the container.
WORKDIR /app/otkit

# Default to the OT command centre; compose/the menu override with a subcommand.
CMD ["pyscan", "monitor", "--tui"]
